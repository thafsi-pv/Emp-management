# ============================================================
# Supabase PostgreSQL Connection
# ============================================================
# Get these from: Supabase Dashboard → Project Settings → Database
#
# OPTION 1 — Connection Pooling (Supavisor) — used by the app at runtime
# Mode: Transaction  Port: 6543
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# OPTION 2 — Direct Connection — used only by Prisma migrate/generate
# Port: 5432
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"


# ============================================================
# JWT
# ============================================================
JWT_ACCESS_SECRET="change-this-to-a-long-random-string-in-production"
JWT_REFRESH_SECRET="change-this-to-another-long-random-string-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ============================================================
# App
# ============================================================
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

UPLOADS_DIR="./uploads"
MAX_FILE_SIZE=2097152
