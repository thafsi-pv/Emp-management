# ============================================================
# Docker Production Environment Template (.env.example)
# Copy this file to .env on the Windows server and fill in actual values
# ============================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=emp_management

# Prisma Database URL (Uses Docker service name 'postgres')
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@postgres:5432/emp_management?schema=public

# JWT Security Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File Storage Configuration (local or cloudinary)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=emp_management

# Application Configuration
PORT=3000
NODE_ENV=production
FRONTEND_URL=http://localhost
